# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=your-anon-key

# Supabase S3-compatible storage configuration (for R2 or similar)
SUPABASE_S3_ACCESS_KEY=your-s3-access-key
SUPABASE_S3_SECRET_KEY=your-s3-secret-key
SUPABASE_S3_ENDPOINT=https://your-project.fra1.digitaloceanspaces.com  # Or your R2 endpoint
SUPABASE_S3_REGION=auto
SUPABASE_S3_BUCKET=your-bucket-name
SUPABASE_PUBLIC_URL=https://your-project.supabase.co/storage/v1/object/public
